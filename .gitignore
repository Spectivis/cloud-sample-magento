# Only this project's own files are tracked. `composer install` puts the rest
# of Mage-OS in place (bin/, pub/, setup/, lib/, app/etc/di.xml and so on).
/*
!/.gitignore
!/composer.json
!/composer.lock
!/README.md
!/LICENSE.txt
!/LICENSE_AFL.txt
!/compose.yaml
!/docker/
!/loadtest/
!/scripts/

!/app/
/app/*
!/app/code/
!/app/design/
!/app/etc/
/app/etc/*
!/app/etc/config.php

# Composer's home with its cache folder, made at build. Magento reads its
# version through Composer (the admin dashboard does), and Composer makes these
# folders if they are missing, which fails on a read-only image.
!/var/
/var/*
!/var/composer_home/
/var/composer_home/*
!/var/composer_home/.htaccess
!/var/composer_home/cache/
/var/composer_home/cache/*
!/var/composer_home/cache/.htaccess

# Written per environment (on Spectivis Cloud: at start, from variables).
/app/etc/env.php
/auth.json
/loadtest/results/
