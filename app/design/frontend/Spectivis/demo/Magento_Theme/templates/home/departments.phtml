/**
 * Copyright Spectivis. Licensed under OSL-3.0 and AFL-3.0, as Mage-OS.
 *
 * The top-level categories as photo tiles. A department's photo is
 * images/departments/<url key>.jpg in the theme; one without a photo gets a plain tile.
 */
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Spectivis\DemoStore\ViewModel\Departments;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var Departments $departments */
$departments = $block->getData('departments');
$list = $departments->list();
if (!$list) {
    return;
}
?>
<section class="my-16" aria-labelledby="home-departments-title">
    <h2 id="home-departments-title" class="text-2xl font-semibold md:text-3xl">
        <?= $escaper->escapeHtml(__('Shop by department')) ?>
    </h2>
    <ul class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
        <?php foreach ($list as $department): ?>
            <li>
                <a class="group block" href="<?= $escaper->escapeUrl($department['url']) ?>">
                    <span class="block aspect-[4/5] overflow-hidden rounded-md bg-stone-200">
                        <?php if ($department['image']): ?>
                            <img
                                src="<?= $escaper->escapeUrl($block->getViewFileUrl($department['image'])) ?>"
                                alt=""
                                width="600"
                                height="750"
                                loading="lazy"
                                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                            >
                        <?php endif; ?>
                    </span>
                    <span class="mt-3 block text-base font-medium group-hover:underline">
                        <?= $escaper->escapeHtml($department['name']) ?>
                    </span>
                </a>
            </li>
        <?php endforeach; ?>
    </ul>
</section>
