{
    "name": "spectivis/cloud-sample-magento",
    "description": "Mage-OS demo store with a generated 50,000 SKU catalog, for testing Spectivis Cloud",
    "type": "project",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "config": {
        "allow-plugins": {
            "laminas/laminas-dependency-plugin": true,
            "mage-os/*": true,
            "php-http/discovery": true
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "require": {
        "mage-os/composer-dependency-version-audit-plugin": "4.0.0",
        "mage-os/composer-root-update-plugin": "4.0.0",
        "mage-os/product-community-edition": "4.0.0"
    },
    "autoload": {
        "psr-4": {
            "Magento\\Framework\\": "lib/internal/Magento/Framework/",
            "Magento\\Setup\\": "setup/src/Magento/Setup/",
            "Magento\\": "app/code/Magento/",
            "MageOS\\Installer\\": "setup/src/MageOS/Installer/"
        },
        "psr-0": {
            "": [
                "app/code/",
                "generated/code/"
            ]
        },
        "files": [
            "app/etc/NonComposerComponentRegistration.php"
        ],
        "exclude-from-classmap": [
            "**/dev/**",
            "**/update/**",
            "**/Test/Fixture/**",
            "**/Test/Integration/**",
            "**/Test/Mftf/**",
            "**/Test/Unit/**"
        ]
    },
    "prefer-stable": true,
    "minimum-stability": "stable",
    "extra": {
        "magento-force": "override"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.mage-os.org/"
        }
    ]
}
